# Porta do servidor
PORT=3001

# Usuário e senha do painel admin (fixos por enquanto)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o token de sessão do admin
JWT_SECRET=troque-este-segredo-tambem

# URL pública onde as fotos ficam acessíveis
BASE_URL=http://localhost:3001

# Origem do frontend (dev do Vite), usada no CORS
FRONTEND_ORIGIN=http://localhost:3002
